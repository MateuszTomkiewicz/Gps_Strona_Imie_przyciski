<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_third"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGpsStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status GPS: NIEAKTYWNY"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Szerokość: - , Długość: -"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvGpsStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnStartGps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start GPS"
        app:layout_constraintTop_toBottomOf="@id/tvCoordinates"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnStopGps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Stop GPS"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/btnStartGps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
